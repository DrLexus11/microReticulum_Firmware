# Docker daemon for this machine, replacing the manual ~/bin/docker-start.
#
# This is not upstream's docker.service: the binaries live in ~/docker-bin, the
# data root is ~/docker-data, and the socket is /tmp/docker.sock rather than
# /var/run/docker.sock. Those choices are kept exactly as docker-start had them
# so that every DOCKER_HOST already configured on this machine keeps working.
#
# --iptables=false means Docker installs no NAT of its own, so containers get no
# outbound route without the MASQUERADE rule below; docker-start added it by
# hand after each start and it has to happen here too.
[Unit]
Description=Docker Application Container Engine (IMPR local build)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
Environment=PATH=/home/deck/docker-bin:/usr/local/sbin:/usr/local/bin:/usr/bin
ExecStart=/home/deck/docker-bin/dockerd \
    --data-root=/home/deck/docker-data \
    --host=unix:///tmp/docker.sock \
    --userland-proxy=true \
    --iptables=false
ExecStartPost=/bin/sh -c 'iptables -t nat -C POSTROUTING -s 172.17.0.0/16 ! -o docker0 -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -s 172.17.0.0/16 ! -o docker0 -j MASQUERADE'
Restart=always
RestartSec=3
# Docker needs these to manage containers and its own storage.
LimitNOFILE=infinity
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
Delegate=yes
KillMode=process
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
